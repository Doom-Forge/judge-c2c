{
  "name": "judge-c2c",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --env local",
    "ui:dev": "vite --config frontend/vite.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "ui:build": "vite build --config frontend/vite.config.ts",
    "ui:typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "ui:test": "playwright test --config frontend/playwright.config.ts",
    "ui:test:browser": "playwright test --config frontend/playwright.config.ts",
    "ui:format:check": "prettier --check frontend package.json",
    "ui:format": "prettier --write frontend package.json",
    "ui:check": "npm run ui:typecheck && npm run ui:build && npm run ui:test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tests/browser/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run acceptance:check && npm run ui:build && wrangler deploy --dry-run --env review",
    "db:local": "wrangler d1 migrations apply DB --env local --local",
    "deploy:review": "npm run ui:build && wrangler deploy --env review",
    "deploy": "npm run ui:build && node scripts/production-config.mjs && wrangler deploy --config .wrangler/production.json",
    "test:browser": "playwright test",
    "format:check": "prettier --check src tests public scripts docs examples *.json *.ts .github/workflows",
    "build": "wrangler deploy --dry-run --env=",
    "runner:build": "docker build --tag judge-c2c-runner-local runner",
    "runner:start": "node scripts/local-runner-start.mjs",
    "runner:connect": "node scripts/local-runner-connect.mjs",
    "runner:smoke": "node scripts/local-runner-smoke.mjs",
    "qa:docker": "node scripts/hackathon-docker-rehearsal.mjs",
    "acceptance:update": "node scripts/acceptance-report.mjs",
    "acceptance:check": "node scripts/acceptance-report.mjs --check",
    "organization:setup": "node scripts/organization-workspace.mjs",
    "organization:verify": "node scripts/organization-workspace.mjs verify",
    "organization:retire": "node scripts/organization-workspace.mjs retire",
    "runner:vm:bundle": "esbuild src/qemu-vm.ts --bundle --platform=node --format=esm --outfile=vm-runner/qemu-vm.mjs",
    "runner:vm:smoke": "npm run runner:vm:bundle && node vm-runner/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.12",
    "ky": "1.14.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@rolldown/plugin-babel": "0.3.0",
    "oxc-transform-react": "0.156.0",
    "esbuild": "0.28.1",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5"
  }
}
